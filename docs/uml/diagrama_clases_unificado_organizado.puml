' ============================================================
' DATABASE MODEL
' Fuentes: Persistence/Configurations + Migrations/InitialCreate
' ============================================================
package "Database Model" as DatabaseModel {
  class "users" as db_users <<table>> {
    PK id: uuid
    name: varchar(150)
    email: varchar(256)
    password_hash: varchar(500)
    last_access_at: timestamptz?
    created_at: timestamptz
    created_by: varchar(150)?
    updated_at: timestamptz?
    updated_by: varchar(150)?
    user_type: varchar(40) TPH
    UX ux_users_email(email)
  }

  class "roles" as db_roles <<table>> {
    PK id: uuid
    type: varchar(40)
    name: varchar(80)
    UX ux_roles_name(name)
  }

  class "user_roles" as db_user_roles <<join table>> {
    PK user_id: uuid
    PK role_id: uuid
    FK user_id -> users.id
    FK role_id -> roles.id
    IX ix_user_roles_role_id(role_id)
  }

  class "sessions" as db_sessions <<table>> {
    PK id: uuid
    FK user_id: uuid
    token: varchar(2000)
    created_at: timestamptz
    expires_at: timestamptz
    is_active: boolean = true
    IX ix_sessions_user_id(user_id)
  }

  class "login_attempts" as db_login_attempts <<table>> {
    PK id: uuid
    email: varchar(256)
    succeeded: boolean
    failure_reason: varchar(500)?
    ip_address: varchar(80)?
    user_agent: varchar(512)?
    occurred_at: timestamptz
    IX ix_login_attempts_email(email)
  }

  class "orders" as db_orders <<table>> {
    PK id: uuid
    FK customer_id -> users.id
    number: varchar(80)
    purchase_date: timestamptz
    total: jsonb Money
    UX ux_orders_number(number)
    IX ix_orders_customer_id(customer_id)
  }

  class "products" as db_products <<table>> {
    PK id: uuid
    FK order_id -> orders.id
    sku: varchar(80)
    name: varchar(200)
    quantity: int
    purchase_date: timestamptz
    warranty_until: timestamptz
    unit_price: jsonb Money
    CHECK ck_products_quantity_positive(quantity > 0)
    IX ix_products_order_id(order_id)
    IX ix_products_sku(sku)
  }

  class "requests" as db_requests <<table>> {
    PK id: uuid
    FK customer_id -> users.id
    FK order_id -> orders.id
    FK product_id -> products.id
    type: varchar(30)
    reason: varchar(500)
    description: varchar(2000)
    quantity: int
    solution_preference: varchar(30)
    status: varchar(40)
    created_at: timestamptz
    created_by: varchar(150)?
    updated_at: timestamptz?
    updated_by: varchar(150)?
    CHECK ck_requests_quantity_positive(quantity > 0)
    CHECK ck_requests_reason_not_empty(length(trim(reason)) > 0)
    UX ux_requests_duplicate_guard(customer_id, order_id, product_id, type, reason)
  }

  class "evidence" as db_evidence <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    type: varchar(40)
    file: jsonb FilePath
    file_name: varchar(255)
    size_in_bytes: bigint
    uploaded_by: varchar(150)?
    uploaded_at: timestamptz
    CHECK ck_evidence_size_non_negative(size_in_bytes >= 0)
    IX ix_evidence_request_id(request_id)
  }

  class "request_timeline" as db_request_timeline <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    event: varchar(200)
    previous_status: varchar(40)?
    new_status: varchar(40)?
    created_at: timestamptz
    created_by: varchar(150)?
    IX ix_request_timeline_request_id(request_id)
  }

  class "internal_comments" as db_internal_comments <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    text: varchar(2000)
    author: varchar(150)
    visible_to_customer: boolean = false
    created_at: timestamptz
    IX ix_internal_comments_request_id(request_id)
  }

  class "operational_decisions" as db_operational_decisions <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    approved: boolean
    reason: varchar(1000)
    decided_by: varchar(150)
    decided_at: timestamptz
    CHECK ck_operational_decisions_reason_not_empty(length(trim(reason)) > 0)
    IX ix_operational_decisions_request_id(request_id)
  }

  class "additional_information_requests" as db_additional_info <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    message: varchar(1500)
    deadline: timestamptz
    requested_by: varchar(150)
    requested_at: timestamptz
    is_resolved: boolean = false
    resolved_at: timestamptz?
    response: varchar(2000)?
    IX ix_additional_information_requests_request_id(request_id)
  }

  class "assigned_cases" as db_assigned_cases <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    FK provider_id -> users.id
    assigned_by: varchar(150)
    assigned_at: timestamptz
    status: varchar(40)
    IX ix_assigned_cases_provider_id(provider_id)
    IX ix_assigned_cases_request_id(request_id)
  }

  class "warranty_validations" as db_warranty_validations <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    FK product_id -> products.id
    is_warranty_valid: boolean
    reason: varchar(1000)?
    validated_by: varchar(150)
    validated_at: timestamptz
    UX ux_warranty_validations_request_id(request_id)
    IX ix_warranty_validations_product_id(product_id)
  }

  class "technical_rulings" as db_technical_rulings <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    result: varchar(40)
    technical_reason: varchar(1500)
    observations: varchar(2000)
    issued_by: varchar(150)
    issued_at: timestamptz
    CHECK ck_technical_rulings_no_procede_reason
    UX ux_technical_rulings_request_id(request_id)
  }

  class "product_receptions" as db_product_receptions <<table>> {
    PK id: uuid
    FK request_id -> requests.id
    address: varchar(500)
    shipping_cost: jsonb Money
    received_at: timestamptz
    received_by: varchar(150)
    UX ux_product_receptions_request_id(request_id)
  }

  class "reports" as db_reports <<table>> {
    PK id: uuid
    title: varchar(200)
    filter: jsonb FiltroReporte
    generated_by: varchar(150)
    generated_at: timestamptz
    IX ix_reports_generated_by_user_id(generated_by)
    IX ix_reports_generated_at(generated_at)
  }

  class "metric_indicators" as db_metric_indicators <<table>> {
    PK id: uuid
    FK report_id -> reports.id
    name: varchar(150)
    value: numeric(18,2)
    unit: varchar(50)
    IX ix_metric_indicators_report_id(report_id)
  }

  class "exported_files" as db_exported_files <<table>> {
    PK id: uuid
    FK report_id -> reports.id
    format: varchar(20)
    file: jsonb FilePath
    file_name: varchar(255)
    exported_by: varchar(150)
    exported_at: timestamptz
    IX ix_exported_files_report_id(report_id)
  }

  class "audit_logs" as db_audit_logs <<table>> {
    PK id: uuid
    FK user_id -> users.id nullable
    action: varchar(120)
    entity_name: varchar(150)
    entity_id: varchar(120)
    old_values: jsonb?
    new_values: jsonb?
    ip_address: varchar(80)?
    user_agent: varchar(512)?
    trace_id: varchar(120)
    created_at: timestamptz
    IX ix_audit_logs_user_id(user_id)
    IX ix_audit_logs_entity(entity_name, entity_id)
    IX ix_audit_logs_created_at(created_at)
  }

  db_users "1" o-- "0..*" db_user_roles : enlaza usuario
  db_roles "1" o-- "0..*" db_user_roles : enlaza rol
  db_users "1" --> "0..*" db_sessions : tiene sesiones
  db_users "1" --> "0..*" db_orders : cliente posee
  db_orders "1" *-- "1..*" db_products : contiene productos
  db_users "1" --> "0..*" db_requests : cliente crea
  db_orders "1" --> "0..*" db_requests : origina solicitudes
  db_products "1" --> "0..*" db_requests : producto reclamado
  db_requests "1" *-- "0..*" db_evidence : contiene evidencia
  db_requests "1" *-- "0..*" db_request_timeline : registra eventos
  db_requests "1" *-- "0..*" db_internal_comments : registra comentarios
  db_requests "1" *-- "0..*" db_operational_decisions : acumula decisiones
  db_requests "1" *-- "0..*" db_additional_info : solicita informacion
  db_requests "1" --> "0..*" db_assigned_cases : asigna proveedor
  db_users "1" --> "0..*" db_assigned_cases : proveedor recibe
  db_requests "1" --> "0..1" db_warranty_validations : valida garantia
  db_products "1" --> "0..*" db_warranty_validations : se valida en
  db_requests "1" --> "0..1" db_technical_rulings : recibe dictamen
  db_requests "1" --> "0..1" db_product_receptions : registra recepcion
  db_reports "1" *-- "0..*" db_metric_indicators : compone metricas
  db_reports "1" *-- "0..*" db_exported_files : registra exportaciones
  db_users "0..1" --> "0..*" db_audit_logs : genera auditoria
}

' ============================================================
' EXTERNAL SERVICES
' ============================================================
package "External Services" as ExternalServices {
  class "Supabase Storage" as SupabaseStorage <<external>> {
    bucket evidence-files
    bucket report-files
  }
  class "JWT Bearer Authentication" as JwtBearer <<external>>
  class "PostgreSQL / Neon" as PostgreSql <<external>>
  class "SMTP/Email Provider" as EmailProvider <<external>>

  SupabaseStorageService "1" --> "1" SupabaseStorage : almacena objetos
  JwtTokenService "1" --> "1" JwtBearer : emite JWT compatible
  AppDbContext "1" --> "1" PostgreSql : persiste modelo
  EmailNotificationService "1" --> "1" EmailProvider : envia notificaciones
}

' ============================================================
' CROSS-LAYER DEPENDENCIES
' ============================================================
SharedLayer "1" ..> "1" ApiLayer : respuestas HTTP
ApiLayer "1" ..> "1" ApplicationLayer : orquesta casos de uso
ApplicationLayer "1" ..> "1" DomainLayer : usa entidades y reglas
InfrastructureLayer "1" ..> "1" ApplicationLayer : implementa puertos
InfrastructureLayer "1" ..> "1" PersistenceLayer : usa DbContext
PersistenceLayer "1" ..> "1" DomainLayer : mapea entidades
AngularFrontend "1" ..> "1" ApiLayer : consume endpoints HTTP

note right of SupabaseStorageService
  Rutas implementadas/esperadas para Storage:
  - evidence/{requestId}/{guid}-{filename}
  - reports/{reportId}/{format}/{guid}-{filename}

  La service_role key se usa solo en backend.
  No debe guardarse ni exponerse al frontend Angular.
end note

note right of AuthController
  Flujo JWT:
  1. AuthController login recibe LoginRequestDto.
  2. AuthService valida usuario/password.
  3. JwtTokenService emite access token.
  4. Angular SessionService guarda token y usuario.
  5. auth-token.interceptor envia Bearer token.
end note

note right of DatabaseSeeder
  Seeders:
  - DatabaseSeeder se ejecuta desde DatabaseSeederExtensions.
  - Extension protegida para entorno Development.
  - Incluye roles, usuarios demo, catalogos, pedidos/productos,
    solicitudes y reportes iniciales.
end note

note right of AngularFrontend
  Seguridad:
  - Angular consume solo la API.
  - No hay acceso directo desde Angular a base de datos ni Supabase.
  - service_role y secretos JWT quedan fuera del frontend.
end note

note bottom of DatabaseModel
  Nombres reales segun EF Core/Migration InitialCreate:
  - provider_assignments no existe; esta implementado como assigned_cases.
  - report_metrics no existe; esta implementado como metric_indicators.
  - technical_rulings es el nombre real de la tabla de dictamen tecnico.
  - users usa TPH mediante user_type: cliente, administrador, proveedor.
end note

note bottom
  Pendientes reales documentados:
  - Limpieza manual de archivos huerfanos de pruebas en Supabase, si aplica.
  - Automatizacion e2e futura, si aplica.

  Este diagrama reemplaza el UML legacy que usaba paquetes com.bigbank.*
  y clases no alineadas con la implementacion actual.
end note

