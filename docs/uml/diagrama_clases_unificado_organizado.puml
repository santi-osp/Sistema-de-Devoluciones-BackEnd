@startuml
title Diagrama de clases unificado actual - Sistema de Devoluciones y Garantias

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam classFontSize 10
skinparam packageFontSize 12
left to right direction
hide circle

legend right
  <b>Relaciones UML usadas</b>
  <|-- Herencia / especializacion
  <|.. Implementacion de interfaz
  *-- Composicion: el todo controla el ciclo de vida de la parte
  o-- Agregacion: relacion todo-parte debil
  --> Asociacion dirigida / uso
  ..> Dependencia transversal entre capas/modulos
endlegend

' ============================================================
' DOMAIN LAYER
' Fuentes: src/DevolucionesGarantias.Domain/*
' ============================================================
package "Domain Layer" as DomainLayer {
  package "Auth Domain" as DomainAuth {
    interface IEntity {
      +Id: Guid
    }

    interface IAuditableEntity {
      +CreatedAt: DateTimeOffset
      +CreatedBy: string?
      +UpdatedAt: DateTimeOffset?
      +UpdatedBy: string?
    }

    abstract class Usuario {
      +Id: Guid
      +Nombre: string
      +Correo: Email
      +PasswordHash: string
      +UltimoAcceso: DateTimeOffset?
      +CreatedAt: DateTimeOffset
      +CreatedBy: string?
      +UpdatedAt: DateTimeOffset?
      +UpdatedBy: string?
      +Roles: IReadOnlyCollection<Rol>
      +Sesiones: IReadOnlyCollection<Sesion>
      +AgregarRol(rol: Rol): void
      +RegistrarSesion(sesion: Sesion): void
      +MarcarActualizacion(updatedBy: string?): void
    }

    class Cliente {
      +Cliente(nombre: string, correo: Email, passwordHash: string, createdBy: string?)
    }

    class Administrador {
      +Administrador(nombre: string, correo: Email, passwordHash: string, createdBy: string?)
    }

    class Proveedor {
      +Proveedor(nombre: string, correo: Email, passwordHash: string, createdBy: string?)
    }

    class Rol {
      +Id: Guid
      +Tipo: RolUsuario
      +Nombre: string
      +Rol(tipo: RolUsuario)
    }

    class Sesion {
      +Id: Guid
      +UsuarioId: Guid
      +Token: string
      +CreatedAt: DateTimeOffset
      +ExpiresAt: DateTimeOffset
      +IsActive: bool
      +IsExpired: bool
      +IsExpiredAt(instant: DateTimeOffset): bool
      +Cerrar(): void
    }

    class LoginAttempt {
      +Id: Guid
      +Correo: Email
      +Succeeded: bool
      +FailureReason: string?
      +IpAddress: string?
      +UserAgent: string?
      +OccurredAt: DateTimeOffset
      +LoginAttempt(correo: Email, succeeded: bool, failureReason: string?, ipAddress: string?, userAgent: string?)
    }
  }

  package "Requests Domain" as DomainRequests {
    class Pedido {
      +Id: Guid
      +ClienteId: Guid
      +Numero: string
      +FechaCompra: DateTimeOffset
      +Total: Money
      +Productos: IReadOnlyCollection<Producto>
      +AgregarProducto(producto: Producto): void
      +ContieneProducto(productoId: Guid): bool
    }

    class Producto {
      +Id: Guid
      +PedidoId: Guid
      +Sku: string
      +Nombre: string
      +Cantidad: int
      +FechaCompra: DateTimeOffset
      +GarantiaHasta: DateTimeOffset
      +PrecioUnitario: Money
    }

    class Solicitud {
      +Id: Guid
      +ClienteId: Guid
      +PedidoId: Guid
      +ProductoId: Guid
      +Tipo: TipoSolicitud
      +Motivo: string
      +Descripcion: string
      +Cantidad: int
      +PreferenciaSolucion: PreferenciaSolucion
      +EstadoActual: EstadoSolicitudEnum
      +CreatedAt: DateTimeOffset
      +CreatedBy: string?
      +UpdatedAt: DateTimeOffset?
      +UpdatedBy: string?
      +Evidencias: IReadOnlyCollection<Evidencia>
      +Timeline: IReadOnlyCollection<RequestTimeline>
      +AgregarEvidencia(evidencia: Evidencia, updatedBy: string?): void
      +EnviarARevision(updatedBy: string?): void
      +Aprobar(motivo: string, updatedBy: string?): void
      +Rechazar(motivo: string, updatedBy: string?): void
      +SolicitarInformacion(motivo: string, updatedBy: string?): void
      +Cerrar(updatedBy: string?): void
      +CambiarEstado(nuevoEstado: EstadoSolicitud, updatedBy: string?, reason: string?): void
    }

    class Evidencia {
      +Id: Guid
      +SolicitudId: Guid
      +Tipo: TipoEvidencia
      +Archivo: FilePath
      +NombreArchivo: string
      +SizeInBytes: long
      +UploadedBy: string?
      +UploadedAt: DateTimeOffset
    }

    class RequestTimeline {
      +Id: Guid
      +SolicitudId: Guid
      +Evento: string
      +EstadoAnterior: EstadoSolicitudEnum?
      +EstadoNuevo: EstadoSolicitudEnum?
      +CreatedAt: DateTimeOffset
      +CreatedBy: string?
    }
  }

  package "Operation Domain" as DomainOperation {
    class ComentarioInterno {
      +Id: Guid
      +SolicitudId: Guid
      +Texto: string
      +Autor: string
      +VisibleToCustomer: bool
      +CreatedAt: DateTimeOffset
    }

    class DecisionOperativa {
      +Id: Guid
      +SolicitudId: Guid
      +Approved: bool
      +Motivo: string
      +DecidedBy: string
      +DecidedAt: DateTimeOffset
    }

    class SolicitudInformacionAdicional {
      +Id: Guid
      +SolicitudId: Guid
      +Mensaje: string
      +Deadline: DateTimeOffset
      +RequestedBy: string
      +RequestedAt: DateTimeOffset
      +IsResolved: bool
      +ResolvedAt: DateTimeOffset?
      +Response: string?
      +Resolver(response: string): void
    }
  }

  package "Provider Domain" as DomainProviders {
    class CasoAsignado {
      +Id: Guid
      +SolicitudId: Guid
      +ProveedorId: Guid
      +AssignedBy: string
      +AssignedAt: DateTimeOffset
      +Estado: EstadoAsignacionProveedor
      +CambiarEstado(estado: EstadoAsignacionProveedor): void
    }

    class ValidacionGarantia {
      +Id: Guid
      +SolicitudId: Guid
      +ProductoId: Guid
      +IsWarrantyValid: bool
      +Reason: string?
      +ValidatedBy: string
      +ValidatedAt: DateTimeOffset
    }

    class DictamenTecnico {
      +Id: Guid
      +SolicitudId: Guid
      +Resultado: ResultadoDictamen
      +MotivoTecnico: string
      +Observaciones: string
      +IssuedBy: string
      +IssuedAt: DateTimeOffset
    }

    class RecepcionProducto {
      +Id: Guid
      +SolicitudId: Guid
      +Direccion: string
      +CostoEnvio: Money
      +ReceivedAt: DateTimeOffset
      +ReceivedBy: string
    }
  }

  package "Reports Domain" as DomainReports {
    class FiltroReporte {
      +Periodo: DateRange?
      +Estado: EstadoSolicitudEnum?
      +TipoSolicitud: TipoSolicitud?
    }

    class Reporte {
      +Id: Guid
      +Titulo: string
      +Filtro: FiltroReporte
      +GeneratedBy: string
      +GeneratedAt: DateTimeOffset
      +Metricas: IReadOnlyCollection<IndicadorMetrica>
      +Archivos: IReadOnlyCollection<ArchivoExportado>
      +AgregarMetrica(metrica: IndicadorMetrica): void
      +RegistrarArchivo(archivo: ArchivoExportado): void
    }

    class IndicadorMetrica {
      +Id: Guid
      +ReporteId: Guid
      +Nombre: string
      +Valor: decimal
      +Unidad: string
    }

    class ArchivoExportado {
      +Id: Guid
      +ReporteId: Guid
      +Formato: FormatoReporte
      +Archivo: FilePath
      +NombreArchivo: string
      +ExportedBy: string
      +ExportedAt: DateTimeOffset
    }
  }

  package "Audit Domain" as DomainAudit {
    class AuditLog {
      +Id: Guid
      +UserId: Guid?
      +Action: string
      +EntityName: string
      +EntityId: string
      +OldValues: string?
      +NewValues: string?
      +IpAddress: string?
      +UserAgent: string?
      +TraceId: string
      +CreatedAt: DateTimeOffset
    }
  }

  package "Value Objects" as DomainVO {
    class Email <<Value Object>> {
      +Value: string
      +ToString(): string
    }

    class Money <<Value Object>> {
      +Amount: decimal
      +Currency: string
    }

    class FilePath <<Value Object>> {
      +Bucket: string
      +Path: string
      +Url: string?
      +ToString(): string
    }

    class DateRange <<Value Object>> {
      +Start: DateTimeOffset
      +End: DateTimeOffset
      +Contains(value: DateTimeOffset): bool
    }
  }

  package "Enums" as DomainEnums {
    enum TipoSolicitud {
      Devolucion = 1
      Garantia = 2
    }

    enum PreferenciaSolucion {
      Reembolso = 1
      Cambio = 2
      Reparacion = 3
    }

    enum EstadoSolicitudEnum {
      Creada = 1
      EnRevision = 2
      PendienteInformacion = 3
      Aprobada = 4
      Rechazada = 5
      Cerrada = 6
    }

    enum RolUsuario {
      Cliente = 1
      Administrador = 2
      Proveedor = 3
      Analista = 4
    }

    enum TipoEvidencia {
      Imagen = 1
      Video = 2
      Pdf = 3
      Comprobante = 4
      Otro = 99
    }

    enum FormatoReporte {
      Csv = 1
      Pdf = 2
    }

    enum ResultadoDictamen {
      Procede = 1
      NoProcede = 2
      RequiereRevisionAdicional = 3
    }

    enum EstadoAsignacionProveedor {
      Asignado = 1
      EnEvaluacion = 2
      InformacionSolicitada = 3
      Dictaminado = 4
      Cerrado = 5
    }

    enum TipoAccionAuditoria {
      LoginExitoso = 1
      LoginFallido = 2
      Logout = 3
      CrearSolicitud = 4
      CargarEvidencia = 5
      CambiarEstado = 6
      AprobarSolicitud = 7
      RechazarSolicitud = 8
      SolicitarInformacionAdicional = 9
      AsignarProveedor = 10
      ValidarGarantia = 11
      RegistrarDictamen = 12
      ExportarReporte = 13
    }
  }

  package "Patterns" as DomainPatterns {
    interface ReglaElegibilidadStrategy {
      +Evaluar(pedido: Pedido, producto: Producto, fechaEvaluacion: DateTimeOffset?): ResultadoElegibilidad
    }

    class ReglaElegibilidadDevolucion {
      +Evaluar(pedido: Pedido, producto: Producto, fechaEvaluacion: DateTimeOffset?): ResultadoElegibilidad
    }

    class ReglaElegibilidadGarantia {
      +Evaluar(pedido: Pedido, producto: Producto, fechaEvaluacion: DateTimeOffset?): ResultadoElegibilidad
    }

    class ContextoElegibilidad {
      -_strategy: ReglaElegibilidadStrategy
      +EstablecerEstrategia(strategy: ReglaElegibilidadStrategy): void
      +Evaluar(pedido: Pedido, producto: Producto, fechaEvaluacion: DateTimeOffset?): ResultadoElegibilidad
    }

    class ResultadoElegibilidad <<record>> {
      +IsEligible: bool
      +Reason: string
      +Eligible(reason: string): ResultadoElegibilidad
      +NotEligible(reason: string): ResultadoElegibilidad
    }

    class SolicitudBuilder {
      +ConCliente(cliente: Cliente): SolicitudBuilder
      +ConPedido(pedido: Pedido): SolicitudBuilder
      +ConProducto(producto: Producto): SolicitudBuilder
      +ConTipo(tipo: TipoSolicitud): SolicitudBuilder
      +ConMotivo(motivo: string): SolicitudBuilder
      +ConDescripcion(descripcion: string): SolicitudBuilder
      +ConCantidad(cantidad: int): SolicitudBuilder
      +ConPreferencia(preferencia: PreferenciaSolucion): SolicitudBuilder
      +AgregarEvidencia(evidencia: Evidencia): SolicitudBuilder
      +AgregarEvidencia(tipo: TipoEvidencia, archivo: FilePath, nombreArchivo: string, sizeInBytes: long, uploadedBy: string?): SolicitudBuilder
      +Build(createdBy: string?): Solicitud
    }

    interface ISolicitudObserver {
      +Actualizar(solicitud: Solicitud, evento: string): void
    }

    interface ISolicitudSubject {
      +Suscribir(observer: ISolicitudObserver): void
      +Desuscribir(observer: ISolicitudObserver): void
      +Notificar(solicitud: Solicitud, evento: string): void
    }

    class SolicitudNotifier {
      +Suscribir(observer: ISolicitudObserver): void
      +Desuscribir(observer: ISolicitudObserver): void
      +Notificar(solicitud: Solicitud, evento: string): void
    }

    abstract class EstadoSolicitud {
      +Value: EstadoSolicitudEnum
      +EnviarARevision(solicitud: Solicitud, updatedBy: string?): void
      +Aprobar(solicitud: Solicitud, motivo: string, updatedBy: string?): void
      +Rechazar(solicitud: Solicitud, motivo: string, updatedBy: string?): void
      +SolicitarInformacion(solicitud: Solicitud, motivo: string, updatedBy: string?): void
      +Cerrar(solicitud: Solicitud, updatedBy: string?): void
    }

    class SolicitudCreada
    class SolicitudEnRevision
    class SolicitudPendienteInformacion
    class SolicitudAprobada
    class SolicitudRechazada
    class SolicitudCerrada

    class EstadoSolicitudFactory {
      +FromEnum(estado: EstadoSolicitudEnum): EstadoSolicitud
    }

    class ServicioGestionDevoluciones {
      +IniciarSolicitud(builder: SolicitudBuilder, createdBy: string?): Solicitud
      +CambiarEstadoSolicitud(solicitud: Solicitud, nuevoEstado: EstadoSolicitud, updatedBy: string?, reason: string?): Solicitud
      +RegistrarDictamen(solicitudId: Guid, resultado: ResultadoDictamen, motivoTecnico: string, observaciones: string, issuedBy: string): DictamenTecnico
      +GenerarReporte(filtro: FiltroReporte, titulo: string, generatedBy: string): Reporte
    }
  }

  package "Exceptions" as DomainExceptions {
    class DomainException
    class BusinessRuleException
    class InvalidStateTransitionException
    class UnauthorizedDomainActionException
    class DuplicateRequestException
  }

  Usuario ..|> IEntity : implementa
  Usuario ..|> IAuditableEntity : implementa
  Solicitud ..|> IEntity : implementa
  Solicitud ..|> IAuditableEntity : implementa
  Usuario <|-- Cliente : especializa
  Usuario <|-- Administrador : especializa
  Usuario <|-- Proveedor : especializa

  Usuario "1" *-- "0..*" Sesion : posee
  Usuario "1" o-- "1..*" Rol : tiene roles
  Cliente "1" --> "0..*" Pedido : posee
  Cliente "1" --> "0..*" Solicitud : crea
  Pedido "1" *-- "1..*" Producto : agrupa
  Solicitud "1" --> "1" Pedido : se basa en
  Solicitud "1" --> "1" Producto : reclama
  Solicitud "1" *-- "0..*" Evidencia : contiene
  Solicitud "1" *-- "0..*" RequestTimeline : registra eventos
  Solicitud "1" *-- "0..*" ComentarioInterno : registra comentarios
  Solicitud "1" *-- "0..*" DecisionOperativa : acumula decisiones
  Solicitud "1" *-- "0..*" SolicitudInformacionAdicional : solicita informacion
  Solicitud "1" --> "0..1" CasoAsignado : se asigna a proveedor
  Solicitud "1" --> "0..1" ValidacionGarantia : recibe validacion
  Solicitud "1" --> "0..1" DictamenTecnico : recibe dictamen
  Solicitud "1" --> "0..1" RecepcionProducto : registra recepcion
  Proveedor "1" --> "0..*" CasoAsignado : atiende casos
  Producto "1" --> "0..*" ValidacionGarantia : se valida en
  Reporte "1" *-- "0..*" IndicadorMetrica : compone metricas
  Reporte "1" *-- "0..*" ArchivoExportado : registra exports
  Reporte "1" *-- "1" FiltroReporte : aplica filtro
  AuditLog "0..*" --> "0..1" Usuario : audita usuario

  ReglaElegibilidadStrategy <|.. ReglaElegibilidadDevolucion : implementa
  ReglaElegibilidadStrategy <|.. ReglaElegibilidadGarantia : implementa
  ContextoElegibilidad "1" --> "1" ReglaElegibilidadStrategy : evalua con
  ContextoElegibilidad "1" --> "1" ResultadoElegibilidad : retorna
  SolicitudBuilder "1" --> "1" Solicitud : construye
  SolicitudBuilder "1" --> "1" Cliente : asigna cliente
  SolicitudBuilder "1" --> "1" Pedido : asigna pedido
  SolicitudBuilder "1" --> "1" Producto : asigna producto
  SolicitudBuilder "1" --> "0..*" Evidencia : adjunta
  ISolicitudSubject <|.. SolicitudNotifier : implementa
  SolicitudNotifier "1" o-- "0..*" ISolicitudObserver : mantiene observadores
  EstadoSolicitud <|-- SolicitudCreada : estado concreto
  EstadoSolicitud <|-- SolicitudEnRevision : estado concreto
  EstadoSolicitud <|-- SolicitudPendienteInformacion : estado concreto
  EstadoSolicitud <|-- SolicitudAprobada : estado concreto
  EstadoSolicitud <|-- SolicitudRechazada : estado concreto
  EstadoSolicitud <|-- SolicitudCerrada : estado concreto
  EstadoSolicitudFactory "1" --> "1" EstadoSolicitud : crea instancia
  Solicitud "1" --> "1" EstadoSolicitud : delega transicion
  ServicioGestionDevoluciones "1" --> "1" SolicitudBuilder : inicia solicitud
  ServicioGestionDevoluciones "1" --> "1" EstadoSolicitud : cambia estado
  ServicioGestionDevoluciones "1" --> "1" DictamenTecnico : registra
  ServicioGestionDevoluciones "1" --> "1" Reporte : genera

  DomainException <|-- BusinessRuleException : especializa
  DomainException <|-- InvalidStateTransitionException : especializa
  DomainException <|-- UnauthorizedDomainActionException : especializa
  BusinessRuleException <|-- DuplicateRequestException : especializa
}

' ============================================================
' APPLICATION LAYER
' Fuentes: src/DevolucionesGarantias.Application/*
' ============================================================
package "Application Layer" as ApplicationLayer {
  package "Auth Application" as AppAuth {
    class LoginRequestDto <<record>> {
      +Email: string
      +Password: string
      +IpAddress: string?
      +UserAgent: string?
    }
    class AuthResponseDto <<record>>
    class CurrentUserDto <<record>>
    class LogoutRequestDto <<record>>
    class AccessValidationDto <<record>>

    interface IUsuarioRepository {
      +GetByEmailAsync(email: Email): Task<Usuario?>
      +GetByIdAsync(id: Guid): Task<Usuario?>
      +AddLoginAttemptAsync(attempt: LoginAttempt): Task
    }
    interface ITokenService {
      +CreateAccessTokenAsync(user: Usuario): Task<TokenDescriptor>
    }
    class TokenDescriptor <<record>>
    interface ISessionStore {
      +CreateAsync(userId: Guid, accessToken: string, expiresAt: DateTimeOffset): Task<Sesion>
      +RevokeAsync(sessionId: Guid, userId: Guid): Task
    }
    interface IPasswordHasher {
      +Hash(password: string): string
      +Verify(password: string, passwordHash: string): bool
    }
    interface IAutorizacionPolicy {
      +CanAccess(user: Usuario, requiredRole: string): bool
      +HasRole(user: Usuario, roleName: string): bool
    }
    class AuthService {
      +LoginAsync(request: LoginRequestDto): Task<ApplicationResponse<AuthResponseDto>>
      +LogoutAsync(request: LogoutRequestDto): Task
      +ValidateAccessAsync(userId: Guid, requiredRole: string): Task<AccessValidationDto>
      +GetCurrentUserAsync(userId: Guid): Task<CurrentUserDto?>
      +ToCurrentUser(user: Usuario): CurrentUserDto
    }
    class LoginRequestValidator
  }

  package "Requests Application" as AppRequests {
    class OrderDto <<record>>
    class ProductDto <<record>>
    class EligibilityResultDto <<record>>
    class CreateRequestDto <<record>>
    class RequestDetailDto <<record>>
    class RequestSummaryDto <<record>>
    class EvidenceDto <<record>>
    class UploadEvidenceDto <<record>>
    class RequestTimelineDto <<record>>

    interface IPedidoRepository {
      +GetByIdAsync(id: Guid): Task<Pedido?>
      +ListByCustomerAsync(customerId: Guid): Task<IReadOnlyCollection<Pedido>>
    }
    interface IProductoRepository {
      +GetByIdAsync(id: Guid): Task<Producto?>
    }
    interface ISolicitudRepository {
      +GetByIdAsync(id: Guid): Task<Solicitud?>
      +ListByCustomerAsync(customerId: Guid): Task<IReadOnlyCollection<Solicitud>>
      +ExistsDuplicateAsync(customerId: Guid, orderId: Guid, productId: Guid, reason: string, type: TipoSolicitud): Task<bool>
      +AddAsync(solicitud: Solicitud): Task
    }
    interface IEvidenciaRepository {
      +ListByRequestAsync(requestId: Guid): Task<IReadOnlyCollection<Evidencia>>
      +AddAsync(evidencia: Evidencia): Task
    }
    class OrdersService {
      +ListByCustomerAsync(customerId: Guid): Task<IReadOnlyCollection<OrderDto>>
      +GetAsync(orderId: Guid, customerId: Guid): Task<OrderDto?>
    }
    class RequestsService {
      +CreateAsync(request: CreateRequestDto): Task<RequestDetailDto>
      +ListByCustomerAsync(customerId: Guid): Task<IReadOnlyCollection<RequestSummaryDto>>
      +GetDetailAsync(requestId: Guid, customerId: Guid): Task<RequestDetailDto?>
      +ChangeStatusAsync(requestId: Guid, status: EstadoSolicitudEnum, reason: string?, changedBy: Guid): Task<RequestDetailDto>
      +CheckEligibilityAsync(type: TipoSolicitud, orderId: Guid, productId: Guid): Task<EligibilityResultDto>
    }
    class EvidenceService {
      +ListByRequestAsync(requestId: Guid, customerId: Guid): Task<IReadOnlyCollection<EvidenceDto>>
      +UploadAsync(request: UploadEvidenceDto, uploadedByUserId: Guid): Task<EvidenceDto>
    }
    class CreateRequestValidator
    class UploadEvidenceValidator
    class RequestMappings <<static>>
  }

  package "Operation Application" as AppOperation {
    class OperationDashboardDto <<record>>
    class OperationRequestDto <<record>>
    class OperationRequestDetailDto <<record>>
    class CreateCommentDto <<record>> {
      +VisibleToCustomer: bool = false
    }
    class InternalCommentDto <<record>>
    class RequestInformationDto <<record>>
    class DecisionDto <<record>>
    class DecisionResultDto <<record>>

    interface IOperationRepository {
      +ListAsync(status: EstadoSolicitudEnum?): Task<IReadOnlyCollection<Solicitud>>
      +GetByIdAsync(requestId: Guid): Task<Solicitud?>
      +AddInformationRequestAsync(informationRequest: SolicitudInformacionAdicional): Task
    }
    interface IComentarioRepository {
      +ListByRequestAsync(requestId: Guid): Task<IReadOnlyCollection<ComentarioInterno>>
      +AddAsync(comment: ComentarioInterno): Task
    }
    interface IDecisionOperativaRepository {
      +AddAsync(decision: DecisionOperativa): Task
      +ListByRequestAsync(requestId: Guid): Task<IReadOnlyCollection<DecisionOperativa>>
    }
    class BandejaOperativaService {
      +GetDashboardAsync(): Task<OperationDashboardDto>
      +ListAsync(status: EstadoSolicitudEnum?): Task<IReadOnlyCollection<OperationRequestDto>>
      +GetDetailAsync(requestId: Guid): Task<OperationRequestDetailDto>
    }
    class RevisionOperativaService {
      +AddCommentAsync(request: CreateCommentDto, authorId: Guid): Task<InternalCommentDto>
      +RequestInformationAsync(request: RequestInformationDto, requestedBy: Guid): Task
      +DecideAsync(request: DecisionDto, decidedBy: Guid): Task<DecisionResultDto>
    }
    class CreateCommentValidator
    class DecisionValidator
    class RequestInformationValidator
  }

  package "Providers Application" as AppProviders {
    class ProviderCaseDto <<record>>
    class ProviderCaseDetailDto <<record>>
    class WarrantyValidationDto <<record>>
    class WarrantyValidationResultDto <<record>>
    class TechnicalReportDto <<record>>
    class TechnicalReportResultDto <<record>>
    class ProviderDecisionDto <<record>>
    class ProductReceptionDto <<record>>
    class ProductReceptionResultDto <<record>>

    interface IProviderCaseRepository {
      +ListByProviderAsync(providerId: Guid): Task<IReadOnlyCollection<CasoAsignado>>
      +GetAssignedCaseAsync(providerId: Guid, requestId: Guid): Task<CasoAsignado?>
      +GetRequestAsync(requestId: Guid): Task<Solicitud?>
      +AddWarrantyValidationAsync(validation: ValidacionGarantia): Task
      +AddProductReceptionAsync(reception: RecepcionProducto): Task
    }
    interface IGarantiaService {
      +IsWarrantyActiveAsync(product: Producto, evaluationDate: DateTimeOffset): Task<bool>
    }
    interface IInventarioService {
      +HasReplacementStockAsync(productId: Guid, quantity: int): Task<bool>
    }
    interface IDictamenRepository {
      +AddAsync(dictamen: DictamenTecnico): Task
      +GetByRequestAsync(requestId: Guid): Task<DictamenTecnico?>
    }
    class GestionProveedorService {
      +ListAssignedAsync(providerId: Guid): Task<IReadOnlyCollection<ProviderCaseDto>>
      +GetAssignedCaseAsync(providerId: Guid, requestId: Guid): Task<ProviderCaseDetailDto>
      +ValidateWarrantyAsync(providerId: Guid, request: WarrantyValidationDto): Task<WarrantyValidationResultDto>
      +RegisterTechnicalReportAsync(providerId: Guid, request: TechnicalReportDto): Task<TechnicalReportResultDto>
      +CanProceedWithProviderDecisionAsync(request: ProviderDecisionDto): Task<bool>
    }
    class RecepcionProductoService {
      +RegisterReceptionAsync(providerId: Guid, request: ProductReceptionDto): Task<ProductReceptionResultDto>
    }
    class WarrantyValidationValidator
    class TechnicalReportValidator
    class ProductReceptionValidator
  }

  package "Reports Application" as AppReports {
